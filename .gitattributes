# Consistent Git line endings across Windows, Git Bash, and Linux/Code Builder.
# Files are stored with LF in Git; checkout line endings are selected below.
* text=auto

# Salesforce DX metadata, templates, scripts, and documentation: LF.
*.xml              text eol=lf
*.json             text eol=lf
*.jsonc            text eol=lf
*.yaml             text eol=lf
*.yml              text eol=lf
*.md               text eol=lf
*.txt              text eol=lf
*.sh               text eol=lf
*.js               text eol=lf
*.ts               text eol=lf
*.html             text eol=lf
*.css              text eol=lf
*.cls              text eol=lf
*.trigger          text eol=lf
*.apex             text eol=lf
*.soql             text eol=lf
*.csv              text eol=lf

# Windows command scripts: CRLF in the working tree.
*.bat              text eol=crlf
*.cmd              text eol=crlf

# PowerShell scripts: CRLF is convenient on Windows.
# For Windows PowerShell 5.1 scripts containing non-ASCII text, use UTF-8 BOM.
# .gitattributes controls line endings, NOT the UTF-8 BOM / text encoding.
*.ps1              text eol=crlf
*.psm1             text eol=crlf
*.psd1             text eol=crlf

# Never rewrite binary assets or archives.
*.zip              binary
*.gz               binary
*.jar              binary
*.pdf              binary
*.png              binary
*.jpg              binary
*.jpeg             binary
*.gif              binary
*.webp             binary
*.ico              binary
*.xlsx             binary
*.xlsm             binary
*.docx             binary
*.pptx             binary
